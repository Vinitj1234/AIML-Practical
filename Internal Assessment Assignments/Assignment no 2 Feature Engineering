      "source": [
        "# IQR method for vibration\n",
        "q1 = telemetry[\"vibration\"].quantile(0.25)\n",
        "q3 = telemetry[\"vibration\"].quantile(0.75)\n",
        "iqr = q3 - q1\n",
        "lower_limit = q1 - 1.5 * iqr\n",
        "upper_limit = q3 + 1.5 * iqr\n",
        "\n",
        "outliers = telemetry[(telemetry[\"vibration\"] < lower_limit) | (telemetry[\"vibration\"] > upper_limit)]\n",
        "print(\"Possible vibration outliers:\", len(outliers))"
      ]
